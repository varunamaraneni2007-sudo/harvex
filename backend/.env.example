# Copy this file to .env and fill in your credentials.
# The .env file is git-ignored — never commit real credentials.

# From: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# From: Supabase Dashboard → Project Settings → API → service_role key
# Use the service_role key (not the anon key) so the backend can write data.
SUPABASE_SERVICE_KEY=your-service-role-secret-key-here

# From: Google Cloud Console → APIs & Services → Credentials → API key
# Enable these APIs for this key:
#   - Routes API          (server-side road distances for transport cost)
#   - Places API (New)    (server-side autocomplete + place details proxy)
# This key is NEVER sent to the browser — it is backend-only.
# Restrict the key to "IP addresses" in Google Cloud Console for safety.
# Leave blank to use static transport-cost fallback and free-text location input.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# From: https://console.anthropic.com → API Keys
# Used to generate farmer-friendly AI explanations of recommended allocations.
# Leave blank to use deterministic fallback explanations (app works either way).
ANTHROPIC_API_KEY=your-anthropic-api-key-here
