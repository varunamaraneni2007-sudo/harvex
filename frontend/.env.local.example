# Copy this file to .env.local and fill in your Supabase project values.
# .env.local is git-ignored — never commit real credentials.

# From: Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# From: Supabase Dashboard → Project Settings → API → anon / public key
# This is the PUBLIC (anon) key — safe to expose in browser code.
# Do NOT use the service_role key here — keep that backend-only.
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
